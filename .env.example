# Browser/client configuration (publishable key only)
VITE_SUPABASE_PROJECT_ID=your-project-reference
VITE_SUPABASE_URL=https://your-project-reference.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server runtime configuration
SUPABASE_PROJECT_ID=your-project-reference
SUPABASE_URL=https://your-project-reference.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only privileged key: never add a VITE_ prefix or expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional secret for trusted scheduled/cron requests. Use a long random value.
CAMPUSCONNECT_CRON_SECRET=replace-with-a-long-random-secret
# During rotation, the prior secret may be accepted briefly:
# CAMPUSCONNECT_CRON_SECRET_PREVIOUS=prior-long-random-secret

# Optional: trusted database tooling only. Keep the real value private.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
